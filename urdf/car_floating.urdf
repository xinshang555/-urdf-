    </collision>
  </link>

  <joint name="hip_lower_joint" type="revolute">
    <origin xyz="-0.009397509 -0.001080906 0" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="leg_lower"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="10" velocity="20"/>
  </joint>
  <joint name="hip_upper_joint" type="revolute">
    <origin xyz="-0.009397509 -0.001080906 0.0315" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="leg_upper"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="10" velocity="20"/>
  </joint>
  <joint name="wheel_lower_joint" type="continuous">
    <origin xyz="-0.00180456 -0.039959274 0" rpy="0 0 0"/>
    <parent link="leg_lower"/>
    <child link="wheel_lower"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="20"/>
  </joint>
  <joint name="wheel_upper_joint" type="continuous">
    <origin xyz="-0.00180456 -0.039959274 0.0035" rpy="0 0 0"/>
    <parent link="leg_upper"/>
    <child link="wheel_upper"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="20"/>
  </joint>

</robot>
