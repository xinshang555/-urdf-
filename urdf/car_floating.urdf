<?xml version="1.0" encoding="utf-8"?>
<!--
  wheel-leg robot : car.urdf
  Generated by urdf/tools/build_final.py (do not hand-edit).

  SOURCE OF TRUTH
    geometry : model/car.STEP  (parsed: assembly transforms + bore features)
    mass     : 质量属性/*.txt  (SolidWorks mass-property reports)

  FRAME (CAD axes, right-handed, metres)
    X : forward   (body long axis, 40 mm)
    Y : height    (25 mm body, leg hangs toward -Y)
    Z : lateral   (across the two wheels; body 35 mm)

  DERIVED GEOMETRY (all verified to <1e-6 mm)
    leg pitch, hip bore to wheel bore           = 40.000000 mm
    wheel outer radius                          =  8.000 mm   (R8 face)
    wheel width                                 =  7.000 mm
    leg  thickness / width                      =  3.500 / 10.000 mm
    body                                        = 40.000 x 25.000 x 35.000 mm
    hip_lower  Z = 0.0        hip_upper  Z = 31.5
    wheel_lower centre Z = -2.0   wheel_upper centre Z = 37.0
      (mirror-symmetric about the body mid-plane Z = 17.5)

  JOINTS
    hip_*_joint    revolute,   axis Z  (leg swings in the X-Y plane)
    wheel_*_joint  continuous, axis Z  (wheel spins about Z)
    Both hip and wheel axes are lateral, because the leg's hip bore and its
    wheel bore are coaxial with the wheel's spin axis.

  MASS (total 25.53 g)
    body 21.53 g | leg 1.14 g x2 | wheel 0.86 g x2
    Inertia tensors are the "by centroid" blocks of the reports,
    converted g*mm^2 to kg*m^2.

  NOTES
    * Meshes are link-local (origin at that link's joint anchor), in metres,
      sharing the CAD axes, so no rpy or offset is needed on <visual>.
    * leg_upper is leg_lower translated; wheel_upper is wheel_lower rotated
      180 deg about Y.  Each link therefore gets its own mesh file.
-->
<robot name="car_wheel_leg">
  <!-- added for simulators: makes `body` a real 6-DOF floating base
       instead of being collapsed into the simulator's world body -->
  <link name="world"/>
  <joint name="floating_base_joint" type="floating">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="body"/>
  </joint>

  <link name="body">
    <inertial>
      <origin xyz="-0.01114 0.0017 0.0175" rpy="0 0 0"/>
      <mass value="0.02153"/>
      <inertia ixx="2.09079e-06" ixy="-3.7498e-07" ixz="0" iyy="3.89021e-06" iyz="0" izz="3.60349e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/body_local.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/body_local.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="leg_lower">
    <inertial>
      <origin xyz="-0.000812491 -0.018049094 0.00175" rpy="0 0 0"/>
      <mass value="0.00114"/>
      <inertia ixx="1.6101e-07" ixy="6.89e-09" ixz="0" iyy="8.7e-09" iyz="0" izz="1.6738e-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_lower_local.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_lower_local.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="leg_upper">
    <inertial>
      <origin xyz="-0.000812491 -0.018049094 0.00175" rpy="0 0 0"/>
      <mass value="0.00114"/>
      <inertia ixx="1.6101e-07" ixy="6.89e-09" ixz="0" iyy="8.7e-09" iyz="0" izz="1.6738e-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_upper_local.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/leg_upper_local.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_lower">
    <inertial>
      <origin xyz="2.069e-06 1.8e-07 -0.00326" rpy="0 0 0"/>
      <mass value="0.00086"/>
      <inertia ixx="1.474e-08" ixy="0" ixz="0" iyy="1.474e-08" iyz="0" izz="2.592e-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_lower_local.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_lower_local.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_upper">
    <inertial>
      <origin xyz="2.069e-06 1.8e-07 0.00326" rpy="0 0 0"/>
      <mass value="0.00086"/>
      <inertia ixx="1.474e-08" ixy="0" ixz="0" iyy="1.474e-08" iyz="0" izz="2.592e-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_upper_local.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel_upper_local.stl"/>
